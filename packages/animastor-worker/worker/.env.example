# Animastor Private Worker — environment (copy to .env next to worker.cjs)
# worker.cjs (and start-worker.sh) load this file automatically; you can also
# export these variables directly. NEVER commit a real credential.

# ── REQUIRED ──────────────────────────────────────────────────────────────
# GPU Hub base URL — the same origin you use in the browser, plus /gpu.
HUB_URL=https://animastor.org/gpu

# Private Worker credential — shown ONCE in Settings → Private Workers at
# creation/rotation. Fail-closed: without it the worker refuses to start.
ANIMASTOR_WORKER_TOKEN=<your-worker-key>

# Worker type: image | audio | video (must match the type chosen in the UI).
WORKER_TYPE=image

# Worker label (any short id; with a token, identity comes from the token).
WORKER_ID=my-private-worker

# ── OPTIONAL (defaults shown) ─────────────────────────────────────────────
# ComfyUI HTTP API port (auto-detected from a running ComfyUI if unset).
#COMFY_PORT=8188
# ComfyUI input directory (default: $HOME/ComfyUI/input).
#COMFY_INPUT_DIR=/home/you/ComfyUI/input
# Worker-local cleanup journal dir (crash-safe recovery; default: next to worker.cjs).
#WORKER_JOURNAL_DIR=/home/you/animastor/cleanup-journal
# Reverse-proxy base path in front of ComfyUI (e.g. notebook deployments).
#NOTEBOOK_PATH=
# Full ComfyUI API base; wins over COMFY_PORT/NOTEBOOK_PATH. The installer and
# start-worker.sh write the URL that actually answered GET /system_stats
# (plain http://127.0.0.1:<port> first, the notebook prefix only as fallback).
#COMFY_URL=http://127.0.0.1:8188
# Node.js >= 20 binary used to run the worker (the installer records the one
# it verified; start-worker.sh and the `animastor` tool use the same binary).
#NODE_BIN=/usr/bin/node
# Node-class readiness (bundle >= 2.2.2): the worker asks for tasks only after
# ComfyUI's /object_info lists every node class of its profile. The list comes
# from REQUIRED_NODE_CLASSES (comma-separated) or node-classes.json next to
# worker.cjs ({"profiles":{"audio/qwen-tts":["ClassA",…]}}); without a list
# readiness = ComfyUI API only. Re-check backoff 5 s → 300 s.
#REQUIRED_NODE_CLASSES=
#NODE_CLASSES_FILE=/home/you/animastor/worker/node-classes.json
#NODE_CLASS_RECHECK_MIN_MS=5000
#NODE_CLASS_RECHECK_MAX_MS=300000
# Protocol (bundle >= 2.4.0): both = ask the hub relay /v3/task/next first
# (orchestration v2: result PUT straight to Animastor, cancel via beacon),
# then the classic /task/next; v2only = the classic loop only (no /v3 calls).
#WORKER_PROTOCOL=both
# Protocol 3 delivery: attempts of the result PUT / error POST on network
# error or 5xx (backoff 1 → 2 → 4 → 8 s); socket idle limit of one upload.
#V3_DELIVERY_ATTEMPTS=5
#V3_UPLOAD_IDLE_MS=120000
#
# ── Hugging Face (for gated/private models) ────────────────────────────────
# System HF token — used by the installer to download gated models.
# Set via environment variable; never commit the token to a file.
# The installer uses HF_TOKEN or HUGGINGFACE_HUB_TOKEN (either works).
# HF_TOKEN=
# HUGGINGFACE_HUB_TOKEN=
